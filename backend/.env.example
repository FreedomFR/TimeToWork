DATABASE_URL=postgresql://timetowork:timetowork@localhost:5432/timetowork
# Signs every session. Generate a long random value: openssl rand -hex 32
# (with DEV_MODE=false the server refuses to start on a placeholder or a value under 32 characters)
JWT_SECRET=change-me-in-production
PORT=4000

APP_URL=http://localhost:5173

# DANGER — dev/local use only, see .env.example at the repo root
DEV_MODE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
