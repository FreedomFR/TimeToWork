datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  password            String
  name                String
  role                Role        @default(USER)
  resetTokenHash      String?     @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime    @default(now())
  projects            Project[]
  clients             Client[]
  tags                Tag[]
  timeEntries         TimeEntry[]
  logs                LogEntry[]
}

model Client {
  id        String    @id @default(uuid())
  name      String
  archived  Boolean   @default(false)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String      @id @default(uuid())
  name        String
  color       String      @default("#03A9F4")
  archived    Boolean     @default(false)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  createdAt   DateTime    @default(now())
}

model Tag {
  id          String         @id @default(uuid())
  name        String
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntryTag[]
  createdAt   DateTime       @default(now())
}

model TimeEntry {
  id          String         @id @default(uuid())
  description String         @default("")
  start       DateTime
  end         DateTime?
  billable    Boolean        @default(false)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags        TimeEntryTag[]
  createdAt   DateTime       @default(now())

  @@index([userId, start])
}

model TimeEntryTag {
  timeEntryId String
  tagId       String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([timeEntryId, tagId])
}

// Application journal, readable by admins only: server and browser errors, failed logins,
// rate-limit hits, refused accesses, validation failures and admin actions.
// Never holds passwords, tokens or request bodies.
model LogEntry {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  level      String // info | warn | error
  type       String // see LOG_TYPES in src/lib/logger.ts
  message    String
  method     String?
  path       String?
  statusCode Int?
  details    String? // stack trace or small JSON, truncated
  // The account concerned. SetNull keeps the line when the account is deleted;
  // userEmail is a snapshot so the line stays readable afterwards.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
}
