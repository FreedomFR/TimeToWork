POSTGRES_USER=timetowork
POSTGRES_PASSWORD=timetowork
POSTGRES_DB=timetowork

# Signs every session. Generate a long random value: openssl rand -hex 32
# (with DEV_MODE=false the server refuses to start on a placeholder or a value under 32 characters)
JWT_SECRET=change-me-in-production

VITE_API_URL=http://localhost:4000/api

# Public URL of the frontend, used to build password reset links
APP_URL=http://localhost:8080

# DANGER — dev/local use only. When true, the login screen lists every
# account and lets you sign in as any of them with a single click, no
# password required. Never enable this on a deployment reachable by anyone
# but you.
DEV_MODE=false

# SMTP settings for sending password reset emails.
# Leave SMTP_HOST empty to disable emails: reset links will just be printed
# to the backend container logs (docker compose logs backend) instead.
#
# Example with a Gmail account (create an "app password" in your Google
# account security settings — your normal password won't work):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Only if the API sits behind a reverse proxy (nginx, a load balancer...): a number of proxies,
# "true", or a subnet like "loopback". It lets the journal and the rate limits see the visitor's
# real address instead of the proxy's. Leave empty when the API is reached directly.
TRUST_PROXY=

# Database backups: the "backup" service dumps the database into ./backups.
# How often (minutes; 1440 = every day, 360 = every 6 hours, 60 = every hour)
BACKUP_INTERVAL_MINUTES=1440
# Backups older than this many days are deleted...
BACKUP_KEEP_DAYS=14
# ...but the newest ones are always kept, whatever their age
BACKUP_KEEP_MIN=3
